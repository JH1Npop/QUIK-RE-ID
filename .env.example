# Copy to .env and fill in values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=

# PostgreSQL, format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP: SMTP login, SMTP key, and a sender address verified in Brevo
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional: the portal's public address, used for the link in status emails (e.g. https://your-app.example.com)
SITE_URL=

# Optional: password for the seed_demo users (otherwise a random one is printed)
SEED_DEMO_PASSWORD=

# Optional: hidden path for the Django admin, e.g. backoffice-xxxxxxxx/ (empty = switched off)
ADMIN_URL=
